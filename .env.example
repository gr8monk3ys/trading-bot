# Alpaca API Credentials
# Get your keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Trading Mode
# True = Paper trading (recommended for testing)
# False = Live trading with real money (use with extreme caution!)
PAPER=True

# =============================================================================
# DATABASE (optional)
# =============================================================================

# DATABASE_URL=sqlite:///trading_bot.db

# Dashboard authentication (required — the web dashboard fails closed without it).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Browser: open http://host:8000/?token=<value> once; API: Authorization: Bearer <value>
DASHBOARD_TOKEN=
